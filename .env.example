TELEMETRYFORGE_ADDRESS=:8080
TELEMETRYFORGE_KAFKA_BROKERS=localhost:9092
TELEMETRYFORGE_KAFKA_CLIENT_ID=telemetryforge-gateway
TELEMETRYFORGE_KAFKA_RAW_TOPIC=telemetry.raw
TELEMETRYFORGE_KAFKA_METRIC_TOPIC=telemetry.metrics

# Stream-processing worker
TELEMETRYFORGE_WORKER_CLIENT_ID=telemetryforge-worker
TELEMETRYFORGE_WORKER_GROUP_ID=telemetryforge-processors
TELEMETRYFORGE_WORKER_TOPICS=telemetry.raw,telemetry.metrics
TELEMETRYFORGE_WORKER_COUNT=4
TELEMETRYFORGE_WORKER_QUEUE_CAPACITY=256
TELEMETRYFORGE_WORKER_DLQ_TOPIC=telemetry.dlq

# PostgreSQL / TimescaleDB persistence
TELEMETRYFORGE_DATABASE_URL=postgres://telemetryforge:telemetryforge@localhost:5432/telemetryforge?sslmode=disable

# Automatic incident thresholds
TELEMETRYFORGE_INCIDENT_LATENCY_MS=1000
TELEMETRYFORGE_INCIDENT_ERROR_COUNT=5

# Policy / Cardinality Firewall
TELEMETRYFORGE_WORKER_ADMIN_ADDRESS=:8081
TELEMETRYFORGE_POLICY_FILE=/etc/telemetryforge/policies/active.json
TELEMETRYFORGE_SHADOW_POLICY_FILE=/etc/telemetryforge/policies/shadow.json
TELEMETRYFORGE_CARDINALITY_MAX_DIMENSIONS=20000


# v0.9.0 self-observability
# Empty disables trace export for direct development.
TELEMETRYFORGE_OTLP_TRACES_ENDPOINT=


# v1.0.0 authentication / tenant isolation
# Local Docker Compose uses disabled auth. Production should use api_key.
TELEMETRYFORGE_AUTH_MODE=disabled
TELEMETRYFORGE_API_KEYS_FILE=security/api-keys.example.json
TELEMETRYFORGE_DEFAULT_TENANT=default
TELEMETRYFORGE_TENANT_ID=default

# Presentation-time redaction. Stored Flight Recorder evidence remains full
# fidelity; these controls apply to API/dashboard/live-stream responses.
TELEMETRYFORGE_REDACT_TAG_KEYS=authorization,cookie,email,user_email,token,password,api_key
TELEMETRYFORGE_REDACT_PAYLOAD=false

# Kafka production security profile. Empty/false preserves the local plaintext
# development broker.
TELEMETRYFORGE_KAFKA_TLS=false
TELEMETRYFORGE_KAFKA_CA_FILE=
TELEMETRYFORGE_KAFKA_CERT_FILE=
TELEMETRYFORGE_KAFKA_KEY_FILE=
TELEMETRYFORGE_KAFKA_SASL_MECHANISM=disabled
TELEMETRYFORGE_KAFKA_SASL_USERNAME=
TELEMETRYFORGE_KAFKA_SASL_PASSWORD=

# Dashboard server-side proxy. The raw read key belongs only in the dashboard
# server environment, never browser JavaScript.
TELEMETRYFORGE_API_BASE=http://localhost:8080
TELEMETRYFORGE_DASHBOARD_API_KEY=

# v1.1.0 Schema Intelligence
# true keeps schema-registry outages from blocking normal telemetry processing.
TELEMETRYFORGE_SCHEMA_FAIL_OPEN=true


# v1.2.0 Distributed Cardinality Intelligence
# Production workers automatically use the configured PostgreSQL/TimescaleDB
# store for shared hourly cardinality state. Series budgets are defined in the
# active/shadow policy JSON; there is no separate replica-local production mode.


# v1.3.0 Telemetry Router
TELEMETRYFORGE_ROUTING_FILE=routing/active.json
TELEMETRYFORGE_SHADOW_ROUTING_FILE=routing/shadow.json
TELEMETRYFORGE_ROUTER_ADMIN_ADDRESS=:8082

# HTTP destination secrets should be referenced by environment variable name
# in routing JSON via bearer_token_env. Do not put bearer tokens in JSON.
