{
  "name": "candidate-routing",
  "version": "1.8.0-shadow",
  "destinations": [
    {
      "name": "primary",
      "type": "connector",
      "enabled": true,
      "connector": {
        "kind": "kafka",
        "topic": "telemetry.routed.primary"
      }
    },
    {
      "name": "security",
      "type": "connector",
      "enabled": true,
      "connector": {
        "kind": "kafka",
        "topic": "telemetry.routed.security"
      }
    },
    {
      "name": "archive",
      "type": "connector",
      "enabled": true,
      "connector": {
        "kind": "kafka",
        "topic": "telemetry.routed.archive"
      }
    }
  ],
  "fallback_destination": "primary",
  "rules": [
    {
      "name": "all-errors-to-security",
      "tenant": "*",
      "source": "*",
      "type": "*",
      "severity": [
        "error",
        "critical",
        "fatal"
      ],
      "destinations": [
        "primary",
        "security"
      ]
    },
    {
      "name": "checkout-slow-path",
      "tenant": "*",
      "source": "checkout-*",
      "type": "request.duration",
      "tags": {
        "environment": "prod*"
      },
      "destinations": [
        "primary",
        "security"
      ]
    }
  ]
}
