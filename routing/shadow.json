{
  "name": "candidate-routing",
  "version": "1.3.0-shadow",
  "destinations": [
    {"name": "primary", "type": "kafka", "enabled": true, "topic": "telemetry.routed.primary"},
    {"name": "security", "type": "kafka", "enabled": true, "topic": "telemetry.routed.security"},
    {"name": "archive", "type": "kafka", "enabled": true, "topic": "telemetry.routed.archive"}
  ],
  "fallback_destination": "primary",
  "rules": [
    {
      "name": "all-errors-to-security",
      "tenant": "*",
      "source": "*",
      "type": "*",
      "severity": ["error", "critical", "fatal"],
      "destinations": ["primary", "security"]
    },
    {
      "name": "checkout-slow-path",
      "tenant": "*",
      "source": "checkout-*",
      "type": "request.duration",
      "tags": {"environment": "prod*"},
      "destinations": ["primary", "security"]
    }
  ]
}
