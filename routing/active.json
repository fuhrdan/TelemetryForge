{
  "name": "default-routing",
  "version": "1.8.0",
  "destinations": [
    {
      "name": "primary",
      "type": "connector",
      "enabled": true,
      "connector": {
        "kind": "kafka",
        "topic": "telemetry.routed.primary",
        "timeout_ms": 5000
      },
      "max_attempts": 5,
      "base_delay_ms": 500,
      "max_delay_ms": 30000,
      "concurrency": 2,
      "failure_fallback": "archive"
    },
    {
      "name": "security",
      "type": "connector",
      "enabled": true,
      "connector": {
        "kind": "kafka",
        "topic": "telemetry.routed.security",
        "timeout_ms": 5000
      },
      "max_attempts": 5,
      "base_delay_ms": 500,
      "max_delay_ms": 30000,
      "concurrency": 2,
      "failure_fallback": "archive"
    },
    {
      "name": "archive",
      "type": "connector",
      "enabled": true,
      "connector": {
        "kind": "kafka",
        "topic": "telemetry.routed.archive",
        "timeout_ms": 5000
      },
      "max_attempts": 8,
      "base_delay_ms": 1000,
      "max_delay_ms": 60000,
      "concurrency": 1
    }
  ],
  "fallback_destination": "primary",
  "rules": [
    {
      "name": "production-errors",
      "tenant": "*",
      "source": "*",
      "type": "*",
      "severity": [
        "error",
        "critical",
        "fatal"
      ],
      "tags": {
        "environment": "prod*"
      },
      "destinations": [
        "primary",
        "security"
      ]
    },
    {
      "name": "audit-events",
      "tenant": "*",
      "source": "*",
      "type": "audit.*",
      "destinations": [
        "primary",
        "archive"
      ]
    }
  ]
}
