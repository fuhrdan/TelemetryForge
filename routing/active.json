{
  "name": "default-routing",
  "version": "1.3.0",
  "destinations": [
    {
      "name": "primary",
      "type": "kafka",
      "enabled": true,
      "topic": "telemetry.routed.primary",
      "max_attempts": 5,
      "base_delay_ms": 500,
      "max_delay_ms": 30000,
      "concurrency": 2,
      "failure_fallback": "archive"
    },
    {
      "name": "security",
      "type": "kafka",
      "enabled": true,
      "topic": "telemetry.routed.security",
      "max_attempts": 5,
      "base_delay_ms": 500,
      "max_delay_ms": 30000,
      "concurrency": 2,
      "failure_fallback": "archive"
    },
    {
      "name": "archive",
      "type": "kafka",
      "enabled": true,
      "topic": "telemetry.routed.archive",
      "max_attempts": 8,
      "base_delay_ms": 1000,
      "max_delay_ms": 60000,
      "concurrency": 1
    }
  ],
  "fallback_destination": "primary",
  "rules": [
    {
      "name": "production-errors",
      "tenant": "*",
      "source": "*",
      "type": "*",
      "severity": ["error", "critical", "fatal"],
      "tags": {"environment": "prod*"},
      "destinations": ["primary", "security"]
    },
    {
      "name": "audit-events",
      "tenant": "*",
      "source": "*",
      "type": "audit.*",
      "destinations": ["primary", "archive"]
    }
  ]
}
