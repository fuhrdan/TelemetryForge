{
  "name": "candidate-cardinality-policy",
  "version": "1.2.0-shadow",
  "default_unique_threshold": 750,
  "default_action": "allow",
  "dangerous_keys": [
    "request_id",
    "session_id",
    "trace_id",
    "user_id",
    "order_id",
    "uuid",
    "token",
    "device_id"
  ],
  "rules": [
    {
      "source": "*",
      "type": "*",
      "dimension": "request_id",
      "unique_threshold": 75,
      "action": "drop_tag"
    },
    {
      "source": "*",
      "type": "*",
      "dimension": "session_id",
      "unique_threshold": 150,
      "action": "drop_tag"
    },
    {
      "source": "*",
      "type": "*",
      "dimension": "trace_id",
      "unique_threshold": 300,
      "action": "drop_tag"
    },
    {
      "source": "*",
      "type": "*",
      "dimension": "user_id",
      "unique_threshold": 500,
      "action": "quarantine"
    },
    {
      "source": "*",
      "type": "*",
      "dimension": "device_id",
      "unique_threshold": 500,
      "action": "quarantine"
    }
  ],
  "budgets": [
    {
      "name": "tenant-hourly-series",
      "source": "*",
      "type": "*",
      "series_limit": 35000,
      "warning_percent": 70,
      "critical_percent": 90
    },
    {
      "name": "checkout-hourly-series",
      "source": "checkout-*",
      "type": "*",
      "series_limit": 7500,
      "warning_percent": 65,
      "critical_percent": 85
    }
  ]
}
