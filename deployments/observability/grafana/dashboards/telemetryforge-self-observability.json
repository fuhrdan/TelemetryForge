{
  "uid": "telemetryforge-self-observability",
  "title": "TelemetryForge Self-Observability",
  "tags": [
    "telemetryforge",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Gateway request rate",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetryforge-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(telemetryforge_http_requests_total{service=\"gateway\"}[1m])) by (route)",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Gateway p95 request latency",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetryforge-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(telemetryforge_http_request_duration_seconds_bucket{service=\"gateway\"}[5m])) by (le, route))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Worker queue depth / capacity",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetryforge-prometheus"
      },
      "targets": [
        {
          "expr": "telemetryforge_worker_queue_depth{service=\"worker\"}",
          "legendFormat": "depth",
          "refId": "A"
        },
        {
          "expr": "telemetryforge_worker_queue_capacity{service=\"worker\"}",
          "legendFormat": "capacity",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Kafka consumer lag",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetryforge-prometheus"
      },
      "targets": [
        {
          "expr": "telemetryforge_kafka_consumer_lag_total{service=\"worker\"}",
          "legendFormat": "total lag",
          "refId": "A"
        },
        {
          "expr": "telemetryforge_kafka_consumer_lag{service=\"worker\"}",
          "legendFormat": "{{topic}} p{{partition}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Worker outcomes",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetryforge-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(telemetryforge_worker_jobs_total{service=\"worker\"}[1m])) by (outcome)",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Retries & DLQ",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetryforge-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(telemetryforge_worker_retries_total{service=\"worker\"}[5m])) by (classification)",
          "legendFormat": "retry {{classification}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(telemetryforge_dead_letters_total{service=\"worker\"}[5m])) by (classification)",
          "legendFormat": "DLQ {{classification}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Accepted telemetry / sec",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetryforge-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(telemetryforge_accepted_events_total{service=\"gateway\"}[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Kafka publish failures / sec",
      "gridPos": {
        "x": 8,
        "y": 24,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetryforge-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(telemetryforge_kafka_publish_failures_total{service=\"gateway\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Worker processing p95",
      "gridPos": {
        "x": 16,
        "y": 24,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetryforge-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(telemetryforge_worker_job_duration_seconds_bucket{service=\"worker\"}[5m]))",
          "refId": "A"
        }
      ]
    }
  ]
}
