{
  "name": "default-adaptive-shaping",
  "version": "1.4.0",
  "default_sample_rate": 1.0,
  "protection": {
    "errors": true,
    "severities": [
      "error",
      "critical",
      "fatal"
    ],
    "types": [
      "audit.*",
      "deployment.*",
      "security.*",
      "rollback.*",
      "release.*",
      "change.*",
      "feature_flag.*",
      "configuration.*",
      "infrastructure.*"
    ],
    "tags": {
      "incident_id": "*",
      "telemetryforge.incident_id": "*"
    },
    "latency_threshold_ms": 1000
  },
  "pressure": {
    "enabled": true,
    "high_watermark": 0.7,
    "critical_watermark": 0.9,
    "high_factor": 0.6,
    "critical_factor": 0.25
  },
  "rules": [
    {
      "name": "healthy-request-duration",
      "tenant": "*",
      "source": "*",
      "type": "request.duration",
      "sample_rate": 0.5,
      "min_sample_rate": 0.1,
      "drop_tags": [
        "debug_id"
      ],
      "rename_tags": {
        "http.method": "http.request.method"
      },
      "payload_max_bytes": 32768,
      "payload_action": "drop",
      "stop": true
    },
    {
      "name": "debug-events",
      "tenant": "*",
      "source": "*",
      "type": "debug.*",
      "sample_rate": 0.1,
      "min_sample_rate": 0.02,
      "payload_max_bytes": 8192,
      "payload_action": "drop",
      "stop": true
    }
  ]
}
